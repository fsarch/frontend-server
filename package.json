{
  "name": "static-file-server",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "fsarch-server build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "fsarch-server start",
    "start:prod": "node dist/main",
    "typeorm": "node --loader ts-node/esm ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm migration:run -- -d ./config/typeorm.js",
    "migration:generate": "npm run typeorm -- -d ./config/typeorm.js migration:generate ./src/database/migrations/",
    "migration:create": "npm run typeorm -- migration:create ./src/database/migrations/$npm_config_name"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-braun/static-file-server.git"
  },
  "author": "Michael Braun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michael-braun/static-file-server/issues"
  },
  "homepage": "https://github.com/michael-braun/static-file-server#readme",
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.13.3",
    "@types/tar": "^7.0.87",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@fsarch/server": "^0.1.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "adm-zip": "^0.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "joi": "^18.2.3",
    "js-yaml": "^5.2.3",
    "lru-cache": "^7.17.0",
    "mime-types": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "semaphore-async-await": "^1.5.1",
    "tar": "^7.5.22",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.1"
  }
}
