{
  "name": "static-file-server",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "fsarch-server build",
    "format": "biome format --write src",
    "lint": "biome check --write src",
    "start": "fsarch-server start",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typeorm": "node --loader ts-node/esm ./node_modules/typeorm/cli.js",
    "migration:run": "pnpm run typeorm migration:run -- -d ./config/typeorm.js",
    "migration:generate": "pnpm run typeorm -- -d ./config/typeorm.js migration:generate ./src/database/migrations/",
    "migration:create": "pnpm run typeorm -- migration:create ./src/database/migrations/$npm_config_name",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-braun/static-file-server.git"
  },
  "author": "Michael Braun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michael-braun/static-file-server/issues"
  },
  "homepage": "https://github.com/michael-braun/static-file-server#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.2",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@fsarch/server": "^0.3.3",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "adm-zip": "^0.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.2",
    "lru-cache": "^11.5.3",
    "mime-types": "^3.0.2",
    "reflect-metadata": "^0.2.2",
    "semaphore-async-await": "^1.5.1",
    "tar": "^7.5.22",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
